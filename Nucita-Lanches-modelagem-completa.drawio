        <mxCell id="legend" value="&lt;b&gt;COMO LER&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK: chave primária · FK: chave estrangeira.&lt;br&gt;1: exatamente um · 0..*: zero ou vários.&lt;br&gt;Cada item pertence a um pedido e referencia um produto." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#38262D;fontSize=14;rounded=1;arcSize=8;fillColor=#EDE3D7;strokeColor=none;align=left;verticalAlign=top;spacing=18;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="350" height="180" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;DADOS CALCULADOS E HIPÓTESES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Subtotal do item = preço do produto × quantidade.&lt;br&gt;Total do pedido = soma dos subtotais. Não são colunas armazenadas neste modelo.&lt;br&gt;Pedido recém-aberto pode estar vazio (hipótese de modelagem). IDs e chaves foram propostos para persistência." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#38262D;fontSize=14;rounded=1;arcSize=8;fillColor=#EDE3D7;strokeColor=none;align=left;verticalAlign=top;spacing=18;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="775" width="1230" height="140" as="geometry" />
        </mxCell>
